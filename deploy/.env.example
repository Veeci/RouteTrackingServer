# Copy to deploy/.env (gitignored) and fill in. Names only here; real values never go in git.

# Environment profile: dev | test | staging | prod
APP_ENV=dev

# PostgreSQL (used by compose's db service and by the app from phase 1)
DB_NAME=rts
DB_USER=rts
DB_PASSWORD=change-me-locally
DB_PORT=5432

# Signing key for access tokens (JWT), at least 32 characters. Generate one, for example: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-0123456789

# Logs: text (default, for terminals) or json (for log platforms; the Docker image uses json).
# LOG_FORMAT=text

# Any app setting can be overridden the same way: the key path in capitals, dots as underscores,
# e.g. HTTP_RATELIMITPERMINUTE=600 or WS_MAXFRAMEBYTES=131072 (keys: app/src/main/resources/config/base.conf).

# Tracing: uncomment to attach the OpenTelemetry agent (use with --profile observability)
# OTEL_JAVA_TOOL_OPTIONS=-javaagent:/app/otel/opentelemetry-javaagent.jar

# Monitoring profile (phase 10c): a Discord channel webhook for alerts. Leave unset to notify nobody.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# Scale profile (phase 10a): share live updates between app instances.
# REDIS_URL=redis://redis:6379

# Staging only (phase 1.5): the token testers send in X-Staging-Token to reach /api/v1/dev/tokens. Required, at least
# 32 characters, when APP_ENV=staging. Generate one: openssl rand -hex 24
# STAGING_ACCESS_TOKEN=

# Behind a reverse proxy on the same machine: take the client address from X-Forwarded-For (phase 1.5, T1b.4).
# Trusted only from a loopback peer. Off by default.
# HTTP_TRUSTFORWARDEDHEADERS=true

# The admin routes' own port (phase 12a), as on staging: /api/v1/admin and /ws/v1/admin then answer only there, and
# 8080 answers 404 for them. 0 (the default) keeps them on 8080. In docker compose use 8081: compose publishes it on
# 127.0.0.1:9080. The simulator's --dashboards need them on 8080, so leave it unset for the fleet load run.
# HTTP_ADMINPORT=8081
