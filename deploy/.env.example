# Copy to deploy/.env (gitignored) and fill in. Names only here; real values never go in git.

# Environment profile: dev | test | staging | prod
APP_ENV=dev

# PostgreSQL (used by compose's db service and by the app from phase 1)
DB_NAME=rts
DB_USER=rts
DB_PASSWORD=change-me-locally
DB_PORT=5432

# Logs: text (default, for terminals) or json (for log platforms; the Docker image uses json).
# LOG_FORMAT=text

# Any app setting can be overridden the same way: the key path in capitals, dots as underscores,
# e.g. HTTP_RATELIMITPERMINUTE=600 or WS_MAXFRAMEBYTES=131072 (keys: app/src/main/resources/config/base.conf).

# Tracing: uncomment to attach the OpenTelemetry agent (use with --profile observability)
# OTEL_JAVA_TOOL_OPTIONS=-javaagent:/app/otel/opentelemetry-javaagent.jar
