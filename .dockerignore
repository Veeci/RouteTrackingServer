# Keep the build context small and free of local state and secrets.
.git
.gradle
.kotlin
.idea
**/build
**/out
# ...but not the source packages named `out` (adapter/out, port/out).
!**/src/**/out
docs
load-tests
*.iml
.DS_Store
local.properties
.env
deploy/.env
# admin-web: local installs and build output. The admin-web image installs and builds its own (12f).
admin-web/node_modules
admin-web/dist
admin-web/generated
admin-web/coverage
admin-web/playwright-report
admin-web/test-results
