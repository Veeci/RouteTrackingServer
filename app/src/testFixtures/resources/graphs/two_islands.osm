<!--
  two_islands.osm: two street networks with no road between them, like the two banks of the
  Red River without a bridge in the extract.

      Island A (4 nodes, a square block)        Island B (3 nodes, a triangle)

        1 ──── 2                                    11
        │      │                                   ╱  ╲
        4 ──── 3                                 12 ── 13

  Island A: way 301 is a closed two-way loop 1-2-3-4-1 (highway=tertiary).
  Island B: way 302 is a closed two-way loop 11-12-13-11 (highway=residential).

  Expected graph after SCC pruning: only island A, so 4 nodes and 8 directed edges.
  Without pruning: 7 nodes and 14 directed edges.
-->
<osm version="0.6" generator="hand-written">
  <node id="1" lat="21.0400" lon="105.8400"/>
  <node id="2" lat="21.0400" lon="105.8410"/>
  <node id="3" lat="21.0390" lon="105.8410"/>
  <node id="4" lat="21.0390" lon="105.8400"/>
  <node id="11" lat="21.0400" lon="105.8700"/>
  <node id="12" lat="21.0390" lon="105.8695"/>
  <node id="13" lat="21.0390" lon="105.8705"/>
  <way id="301">
    <nd ref="1"/><nd ref="2"/><nd ref="3"/><nd ref="4"/><nd ref="1"/>
    <tag k="highway" v="tertiary"/>
  </way>
  <way id="302">
    <nd ref="11"/><nd ref="12"/><nd ref="13"/><nd ref="11"/>
    <tag k="highway" v="residential"/>
  </way>
</osm>
